# ===== 設定の見本 =====
# このファイルをコピーして .env.local を作り、値を書きかえてください（.env.local は Git に入りません）
#   cp .env.example .env.local

# --- AI（Gemini）：どちらか一方でOK ---
# 方法A：Google AI Studio の APIキー（https://aistudio.google.com/apikey）
GEMINI_API_KEY=

# 方法B：Google Cloud の Vertex AI（gcloud auth application-default login でログインしておく）
# 書いてあると方法Aより優先されます
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# 使うモデル
GEMINI_MODEL=gemini-3.8-flash

# --- 合言葉 ---
# 書くと、AIとスイーツの読み込みは合言葉を知っている人だけが使えます（空なら合言葉なし）
ACCESS_CODE=
